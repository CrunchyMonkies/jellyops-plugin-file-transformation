# Plugin-only OCI image-volume payload for JellyOps: the filesystem root IS the
# Jellyfin plugin directory (meta.json + Jellyfin.Plugin.FileTransformation.dll +
# third-party deps). Built from src/Plugin via docker/build-push.sh (host assemblies
# stripped; 0Harmony is embedded in the plugin DLL, not shipped loose).
FROM scratch
COPY plugin/ /
LABEL io.jellyops.plugin.guid="cf7c3f2a-6e1f-4a2c-9a3d-1e5b0c9d4f11" \
      io.jellyops.plugin.name="File Transformation" \
      io.jellyops.plugin.version="2.5.0.0"
